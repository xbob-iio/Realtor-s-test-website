# ─────────────────────────────────────────────────────────────
# Скопируйте этот файл в .env и заполните значения.
# Файл .env не должен попадать в git.
# ─────────────────────────────────────────────────────────────

# Публичный адрес сайта (без слеша в конце). Используется для SEO,
# canonical-ссылок, sitemap и Open Graph. В production — https://ваш-домен
SITE_URL=http://localhost:3000

# PostgreSQL. Для локальной разработки: npm run db:local:init
# (поднимет отдельный кластер на порту 5433 с этими учётными данными)
DATABASE_URL=postgresql://doma:change-me@localhost:5433/doma_rent

# Секрет для подписи токенов форм и хеширования IP.
# Сгенерируйте: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# ── Хранилище фотографий ─────────────────────────────────────
# local — файлы на диске сервера (подходит для VPS)
# s3    — любое S3-совместимое хранилище: AWS S3, Cloudflare R2, MinIO,
#         Supabase Storage (S3 endpoint), DigitalOcean Spaces
STORAGE_DRIVER=local
# Папка для файлов при STORAGE_DRIVER=local
UPLOAD_DIR=storage/uploads

# Параметры для STORAGE_DRIVER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
# Публичный URL бакета, по которому доступны файлы, например
# https://<project>.supabase.co/storage/v1/object/public/<bucket>
STORAGE_PUBLIC_URL=
# true для MinIO и некоторых S3-совместимых сервисов
STORAGE_FORCE_PATH_STYLE=false

# ── Контакты ─────────────────────────────────────────────────
# Начальные значения для настроек сайта (используются при seed).
# Дальше контакты редактируются в админке: /admin/settings
TELEGRAM_URL=
VIBER_URL=
WHATSAPP_URL=
CONTACT_PHONE=
CONTACT_EMAIL=

# Юридические реквизиты (для политики конфиденциальности и условий).
# Также редактируются в админке.
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_EMAIL=
COMPANY_PHONE=

# ── Администратор, создаваемый seed-скриптом ─────────────────
# Если пароль не задан, seed сгенерирует его и выведет один раз в консоль.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# ── Необязательно ────────────────────────────────────────────
# Уведомления о новых заявках в Telegram (бот + id чата)
LEAD_NOTIFY_TELEGRAM_BOT_TOKEN=
LEAD_NOTIFY_TELEGRAM_CHAT_ID=
